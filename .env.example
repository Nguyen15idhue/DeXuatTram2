# ===================== Backend =====================
NODE_ENV=production
PORT=3000
WEB_PORT=8081
TZ=Asia/Ho_Chi_Minh

# Database (backend kết nối bằng user app, KHÔNG dùng root)
DB_HOST=mysql
DB_PORT=3306
DB_USER=station_app
DB_PASSWORD=CHANGE_ME
DB_NAME=station_management

# MySQL container (chỉ dùng lần đầu khởi tạo volume)
MYSQL_ROOT_PASSWORD=CHANGE_ME
MYSQL_DATABASE=station_management
MYSQL_APP_USER=station_app
MYSQL_APP_PASSWORD=CHANGE_ME

# Bảo mật
JWT_SECRET=CHANGE_ME_64_HEX
JWT_EXPIRES_IN=12h

# Domain (đặt domain thật khi deploy; KHÔNG hardcode trong code)
CORS_ORIGINS=https://yourdomain.com
BASE_URL=https://yourdomain.com
FRONTEND_URL=https://yourdomain.com

# Captcha (tạm tắt: CAPTCHA_ENABLED=false và để trống các key)
CAPTCHA_ENABLED=false
TURNSTILE_SECRET_KEY=

# File & Swagger
ORPHAN_FILE_TTL_HOURS=24
ENABLE_SWAGGER=false

# Times New Roman cho chữ ký PDF: thư mục font hợp lệ trên host (dev Windows mặc định trong compose)
SIGNATURE_FONT_HOST_DIR=
# Tùy chọn nếu font có tên file khác chuẩn times.ttf/timesbd.ttf hoặc Times_New_Roman.ttf/*_Bold.ttf
SIGNATURE_FONT_REGULAR=
SIGNATURE_FONT_BOLD=

# ===================== Frontend =====================
# Lưu ý: Vite đọc biến lúc BUILD. Production dùng file frontend/.env.production.
# VITE_API_URL phải là relative '/api', KHÔNG dùng URL tuyệt đối.
VITE_API_URL=/api
VITE_TURNSTILE_SITE_KEY=

# ===================== Chatbot Hướng dẫn =====================
# Provider chính: Google Gemini (free tier). Provider dự phòng: OpenRouter (đổi model bằng env).
# Để trống cả 2 key => endpoint /api/assistant/ask tắt (trả 503), UI ẩn nút chat.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nex-agi/nex-n2.5-mini:free,qwen/qwen3.8-27b:free,nvidia/nemotron-3-super-120b-a12b:free
# Model thi giac OpenRouter (CHI dung khi tin nhan co file/anh kem theo), phan tach dau phay.
# De trong = tin nhan co file chi chay Gemini, loi thi bao loi ro (khong fallback).
OPENROUTER_VISION_MODEL=
ASSISTANT_ENABLED=true
# Chatbot: gioi han file dinh kem (MB/file va so file toi da moi luot hoi)
ASSISTANT_MAX_FILE_MB=5
ASSISTANT_MAX_FILES=3
# Chatbot: bat tri thuc code/schema (bang assistant_code_knowledge, chi SUPER_ADMIN)
ASSISTANT_CODE_KNOWLEDGE=true

# ===================== Đồng bộ nhu cầu sạc lên Google Sheets =====================
# Đường dẫn file service account trên HOST; Docker mount read-only vào backend.
# Windows: dùng dấu /, ví dụ C:/secrets/google-sheets.json.
# Chạy backend trực tiếp ngoài Docker: đặt đường dẫn file credentials trên máy này.
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_TAB_NAME=Sheet1
# Cron 5 phần; mặc định 07:00 mỗi ngày theo TZ=Asia/Ho_Chi_Minh.
EV_REPORT_SHEET_SYNC_CRON=0 7 * * *
