# ===================== Backend =====================
NODE_ENV=production
PORT=3000
WEB_PORT=8081
TZ=Asia/Ho_Chi_Minh

# Database (backend kết nối bằng user app, KHÔNG dùng root)
DB_HOST=mysql
DB_PORT=3306
DB_USER=station_app
DB_PASSWORD=CHANGE_ME
DB_NAME=station_management

# MySQL container (chỉ dùng lần đầu khởi tạo volume)
MYSQL_ROOT_PASSWORD=CHANGE_ME
MYSQL_DATABASE=station_management
MYSQL_APP_USER=station_app
MYSQL_APP_PASSWORD=CHANGE_ME

# Bảo mật
JWT_SECRET=CHANGE_ME_64_HEX
JWT_EXPIRES_IN=12h

# Domain (đặt domain thật khi deploy; KHÔNG hardcode trong code)
CORS_ORIGINS=https://yourdomain.com
BASE_URL=https://yourdomain.com
FRONTEND_URL=https://yourdomain.com

# Captcha (tạm tắt: CAPTCHA_ENABLED=false và để trống các key)
CAPTCHA_ENABLED=false
TURNSTILE_SECRET_KEY=

# File & Swagger
ORPHAN_FILE_TTL_HOURS=24
ENABLE_SWAGGER=false

# Webhook 1Office goi sang (BPA HTTP node -> POST /api/webhooks/oneoffice/proposal-status)
# Header: Authorization: Bearer <secret> (hoac x-webhook-secret). De trong = tat webhook (tra 503).
ONEOFFICE_WEBHOOK_SECRET=CHANGE_ME
# Secret cu (grace period khi xoay) + secret staging, phan tach dau phay. VD: OLDSECRET,STAGINGSECRET
ONEOFFICE_WEBHOOK_SECRET_PREV=
ONEOFFICE_WEBHOOK_SECRET_STAGING=
# IP allowlist egress 1Office (vd 1.2.3.4,5.6.7.*), de trong = tat kiem tra IP
ONEOFFICE_WEBHOOK_IPS=

# ===================== Frontend =====================
# Lưu ý: Vite đọc biến lúc BUILD. Production dùng file frontend/.env.production.
# VITE_API_URL phải là relative '/api', KHÔNG dùng URL tuyệt đối.
VITE_API_URL=/api
VITE_TURNSTILE_SITE_KEY=
