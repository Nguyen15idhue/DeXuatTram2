FROM node:20
WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends imagemagick libreoffice-writer libreoffice-common fontconfig fonts-liberation2 fonts-crosextra-carlito fonts-crosextra-caladea \
    && sample_dir="$(mktemp -d)" \
    && convert -size 2x2 xc:white "$sample_dir/source.png" \
    && for format in jpg png gif webp; do \
        convert "$sample_dir/source.png" "$sample_dir/source.$format" \
        && convert -limit thread 1 "$sample_dir/source.$format[0]" -auto-orient -strip -resize '2048x2048>' 'png:-' > /dev/null || exit 1; \
    done \
    && rm -rf "$sample_dir" /var/lib/apt/lists/*

COPY package*.json ./
RUN npm ci --omit=dev
COPY . .
ENV NODE_ENV=production
EXPOSE 3000
CMD ["sh", "-c", "mkdir -p /usr/share/fonts/truetype/tmt-egreen && cp -f /app/signature-fonts/* /usr/share/fonts/truetype/tmt-egreen/ 2>/dev/null; fc-cache -f 2>/dev/null; npm start"]
